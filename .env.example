# Supabase > Connect > ORMs. Pooled connection (port 6543) for the running site:
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432), used to create and update the tables:
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
# Supabase > Project Settings > API. The service key is secret: never put it in the browser or in GitHub.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SERVICE_KEY="your-secret-service-key"
# Secret that must be in the Selar webhook address: /api/selar/webhook?key=...
SELAR_WEBHOOK_KEY="change-me-webhook-key"
# First admin account, created by `npm run seed` and on every Vercel deploy
ADMIN_EMAIL="admin@greenzone.local"
ADMIN_PASSWORD="ChangeMe123!"
# Public address of the site (used in emails)
SITE_URL="http://localhost:3000"
